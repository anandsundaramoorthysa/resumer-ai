# ---------------------------------------------------------------------------
# Resumer AI — environment
#
# Copy this file to .env and fill in the values. The app shows you exactly what's
# still missing when you load it, so you can add them one at a time rather than
# needing everything up front.
# ---------------------------------------------------------------------------


# ===========================================================================
# REQUIRED — the app cannot sign you in without these
# ===========================================================================

# --- Database --------------------------------------------------------------
# Any Postgres. A free Neon project (neon.tech) is quickest.
# Use the POOLED connection string (the host contains "-pooler").
# After setting this, run:  npm run db:push
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# --- Auth ------------------------------------------------------------------
# Generate with:  npx auth secret
# (or:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET=

# GitHub OAuth App: https://github.com/settings/developers
#   Homepage URL:               http://localhost:3000
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
# Add a second OAuth app (or a second callback) for your deployed URL.
#
# This same sign-in also grants the repo access used to sync your portfolio,
# so there is no separate personal access token to manage.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- Encryption of stored provider tokens -----------------------------------
# The GitHub token is stored with `repo` scope, because GitHub has no read-only
# variant that reaches private repositories — so a leaked database row would be
# read AND write access to every repository that user owns. This key encrypts it
# at rest (AES-256-GCM, lib/auth/secret-box.ts).
#
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# REQUIRED. Every draft starts with a fit check, and the fit check seals its result
# with this key (lib/fit/token.ts) — without it every fit check fails and no draft can
# run. The home page lists it as a setup step until it is set. Losing or changing it
# makes stored tokens unreadable; users simply sign in again. Keep it with your other
# secrets.
TOKEN_ENC_KEY=

# --- GitHub App (recommended, replaces the `repo` OAuth scope) --------------
# Signing in with GitHub currently asks for `repo`, which is read AND WRITE to
# every repository the user owns — the only OAuth scope that can reach a private
# one. A GitHub App replaces that: the user installs it and picks which
# repositories, the permission is `contents: read`, and access becomes a token
# minted per request instead of a credential stored in the database.
#
# Set these and sign-in stops asking for `repo` automatically. Leave them unset
# and everything keeps working exactly as before.
#
# Create one at: https://github.com/settings/apps/new
#   GitHub App name:        anything (the slug below comes from it)
#   Homepage URL:           https://<your-host>
#   Callback URL:           https://<your-host>/api/github/install
#     - tick "Request user authorization (OAuth) during installation": NO
#   Setup URL (optional):   https://<your-host>/api/github/install
#     - tick "Redirect on update": YES
#   Webhook URL:            https://<your-host>/api/webhook/github
#     - secret: the same GITHUB_WEBHOOK_SECRET as below
#   Repository permissions: Contents -> Read-only.  Nothing else.
#   Subscribe to events:    Push, Installation, Installation repositories
#   Where can it be installed: "Only on this account" unless you have users.
#
# Then: "Generate a private key", which downloads a .pem. Paste its whole
# contents below. A key pasted as one line with literal \n sequences is
# normalised for you, so both spellings work.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# The slug from the app's public page URL: github.com/apps/<slug>
GITHUB_APP_SLUG=

# --- Optional ways in ------------------------------------------------------
# Google OAuth: https://console.cloud.google.com/apis/credentials
#   Authorised redirect URI: http://localhost:3000/api/auth/callback/google
# Leave blank and the Google button simply does not appear.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Email (Gmail app password, no domain needed) ---------------------------
# Email sign-up needs somewhere to send the confirmation link. Without this the
# email/password option is hidden rather than offered and then failing — a link
# that cannot be sent strands whoever asked for it.
#
#   1. Turn on 2-Step Verification: myaccount.google.com/security
#   2. Create an app password:      myaccount.google.com/apppasswords
#      Pick "Mail". Google shows 16 characters in four groups — paste it with or
#      without the spaces, they are stripped either way.
#   3. Set the two lines below. Host, port and From are filled in for Gmail.
#
# Limits: about 500 recipients a day, and the mail is authenticated as you
# rather than as a service, so deliverability is worse than a real domain's.
#
# Check your setup at any time with:
#   npx tsx --tsconfig scripts/tsconfig.json scripts/verify-mail.mts you@example.com
SMTP_USER=
# The 16-character app password, WITHOUT the spaces Google shows between its four
# groups. On Netlify set it as one block; `netlify env:set SMTP_PASS abcd efgh ...`
# without quotes keeps only the first group, and Gmail rejects that.
SMTP_PASS=

# Optional display name. Gmail requires the address to be the authenticated
# account, so change the name and leave the address as SMTP_USER.
# Defaults to SMTP_USER when blank.
# EMAIL_FROM="Resumer AI <you@gmail.com>"

# Only needed for a non-Gmail server. Port 465 is implicit TLS, 587 is STARTTLS;
# SMTP_SECURE follows from the port unless you set it.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true

# The links in these emails are built from AUTH_URL (set further down). Without
# it they point at localhost, which is fine locally and useless once deployed.

# --- AI providers — AT LEAST ONE required ----------------------------------
# Tried in this order, falling back to the next on failure or rate-limit.
# Only the ones with a key set are used, so any subset works.
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
DEEPINFRA_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=


# ===========================================================================
# OPTIONAL — everything below has a working fallback if left blank
# ===========================================================================

# --- Job-link scraping -----------------------------------------------------
# Only needed to paste job LINKS. Pasting job TEXT always works without this.
# LinkedIn, Indeed and Glassdoor block scrapers regardless, so those always
# fall back to "paste the text instead". https://firecrawl.dev
FIRECRAWL_API_KEY=

# --- GitHub push webhook ---------------------------------------------------
# Clears the cached commit SHA the moment you push, so the next draft re-parses
# immediately instead of discovering the change on its own.
# Repo Settings -> Webhooks -> payload URL /api/webhook/github (application/json)
GITHUB_WEBHOOK_SECRET=

# --- Daily freshness check -------------------------------------------------
# Enables the scheduled job (netlify/functions/daily-sync.mts -> /api/cron/sync).
# It only checks each connected repo's latest commit SHA and clears the cached one
# where it has changed — it never runs a sync, which takes minutes.
# Any random string; the route rejects every request unless this is set and matches.
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=
# Where the hourly draft-failure alert is emailed (netlify/functions/draft-alerts.mts).
# Uses the same mail provider as sign-in emails. Blank = no alerts.
ALERT_EMAIL=

# --- Model overrides -------------------------------------------------------
# These providers retire model IDs regularly (Groq especially). If calls start
# failing with "model not found", set the one that broke here rather than editing
# code. The names are <PROVIDER>_MODEL and <PROVIDER>_FAST_MODEL, for GEMINI,
# GROQ, DEEPINFRA, TOGETHER and FIREWORKS; current defaults are in lib/ai/.
# GROQ_MODEL=openai/gpt-oss-120b

# --- Cost guardrails -------------------------------------------------------
# Hard caps, enforced regardless of whether the quality score has converged, so
# a stuck loop cannot quietly run up a bill. Defaults shown.
# MAX_AI_CALLS_PER_DRAFT=24
# MAX_AI_TOKENS_PER_DRAFT=400000
# MAX_AI_CALLS_PER_DAY=400
# MAX_AI_TOKENS_PER_DAY=6000000

# --- Deployment ------------------------------------------------------------
# Used for canonical URLs, Open Graph tags, sitemap and robots.txt.
#
# LEAVE THIS BLANK unless you have a custom domain. The host is auto-detected:
# localhost in dev, and the platform's own URL once deployed (Netlify's URL /
# DEPLOY_PRIME_URL, or Vercel's VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL), so
# you don't have to know the deployment URL before deploying.
# Set it explicitly only when you point a real domain at the app.
NEXT_PUBLIC_SITE_URL=

# --- Host-derived URL override (needed on Netlify) --------------------------
# Auth.js builds its OAuth redirect_uri from the request's Host header. Netlify
# serves production under a branch hostname (main--<site>.netlify.app), which
# then does not match the callback URL registered with GitHub, and sign-in fails
# with a Configuration error. Setting AUTH_URL pins the canonical host.
# Not needed on Vercel, where the host already matches.
#
# It is also the base for the confirmation and password-reset links, so set it
# anywhere email sign-up is enabled, Vercel included.
# AUTH_URL=https://your-site.netlify.app
# AUTH_TRUST_HOST=true

# --- Draft time budget (set these on Netlify) -------------------------------
# A serverless platform kills a function the instant it overruns, and a killed
# draft produces nothing — no resume, no error, just a closed connection. The
# draft is built to stop early and keep its best version instead, but only if
# it knows the real ceiling. Netlify does not expose NETLIFY=true to the function
# runtime, so it cannot detect this for itself: set it explicitly.
#
# Know which ceiling you actually have. Netlify's current docs say 60s, which is
# true of credit-based accounts. This site is on a Free plan, and its function
# log shows the draft killed at "Duration: 30000 ms" — thirty seconds, with a
# 50s budget that therefore never got the chance to stop gracefully. Check your
# own function logs rather than the docs.
#
# About 4s is spent before the budget starts (sign-in check, reading the upload,
# loading the profile), so leave that much plus a margin under the ceiling:
#   30s ceiling (Netlify Free):     MAX_DRAFT_SECONDS=20
#   60s ceiling (credit-based):     MAX_DRAFT_SECONDS=50
# MAX_DRAFT_SECONDS=20
#
# How long one AI provider may take before the next is tried. The default of 25s
# is fine under a 300s ceiling and fatal under a 30s one: a single stalled
# provider spent 25 of those 30 seconds and the function died mid-call.
# AI_ATTEMPT_TIMEOUT_MS=10000
#
# Time held back from the AI calls for rendering the PDF and DOCX at the end.
# DRAFT_RENDER_RESERVE_MS=5000
#
# The fit check's own clock, in seconds. It renders nothing, so it can afford more
# than a draft.
# MAX_ASSESS_SECONDS=22

# --- Everyone together, per day --------------------------------------------
# The per-user ceiling is 400 calls; these cap the whole deployment, because
# sign-up is open and a stranger's account spends the same provider keys.
# APP_DAILY_MAX_CALLS=2000
# APP_DAILY_MAX_TOKENS=20000000
#
# The site owner's address(es), comma-separated. These accounts have no daily quota at
# all: their usage does not count toward the shared pool above, and strangers using it
# up never locks them out. Two things still bind them — the burst limit every account
# has (60 AI requests per 10 minutes, per account and per connection), which stops a bot
# or a stolen session in minutes — and an alert, through Sentry, once a day's usage
# passes OWNER_ALERT_CALLS. To stop a session you did not start: reset your password,
# which signs out every session at once.
OWNER_EMAILS=
# OWNER_ALERT_CALLS=1000

# --- Scheduled jobs ---------------------------------------------------------
# Required by /api/cron/* and by the detail half of /api/health. Any long random
# string; without it those routes refuse every request, which is the safe default.
CRON_SECRET=
# Where the hourly draft-failure alert goes (lib/server/draft-alerts.ts).
ALERT_EMAIL=
# How many users one nightly sync pass checks, and how long it may take.
# CRON_MAX_USERS=25
# CRON_BUDGET_MS=20000

# --- Tuning you will rarely touch ------------------------------------------
# The provider order and the cooldown a failing provider serves (lib/ai/models.ts,
# lib/ai/cooldowns.ts).
# AI_PROVIDER_ORDER=fireworks,groq,together,deepinfra,google
# AI_PROVIDER_COOLDOWN_MS=300000
# AI_SLOW_COOLDOWN_MS=120000
# AI_COOLDOWN_CACHE_MS=30000
#
# One portfolio sync step: its whole clock, the size of a slice, and how long a
# single provider attempt inside it may run (lib/sync/stepped.ts).
# SYNC_STEP_BUDGET_MS=8500
# SYNC_SLICE_CHARS=3500
# SYNC_ATTEMPT_TIMEOUT_MS=5500
